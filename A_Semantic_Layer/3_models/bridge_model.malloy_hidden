##! experimental {join_types}

import '../1_sources/bridge.malloy_hidden'

import "../2_extended_sources/order_items.malloy_hidden"
import "../2_extended_sources/users.malloy_hidden"
import "../2_extended_sources/inventory_items.malloy_hidden"
import "../2_extended_sources/products.malloy_hidden"
import "../2_extended_sources/distribution_centers.malloy_hidden"
import "../2_extended_sources/events.malloy_hidden"
import "../2_extended_sources/event_session_facts.malloy_hidden"
import "../2_extended_sources/event_session_funnel.malloy_hidden"
import "../2_extended_sources/orders.malloy_hidden"

source: bridge_model is bridge_source extend {
  
  // fact/transactional tables, that can be connected/analased only via common dimensions, but not directly linked
   join_one: order_items                      on Stage = "order_items" 
   join_one: events                           on Stage = "events"
   join_one: users                            on Stage = "users" 
  
  // tables that desribes connected above fact/transactional tables and directly linked via ids                                   
   join_one: event_session_facts              on Stage = "events"      and events.Session_id    = event_session_facts.Session_id
   join_one: event_session_funnel             on Stage = "events"      and events.Session_id    = event_session_funnel.Session_id

   join_one: orders                           on Stage = "order_items" and order_items.Order_id = orders.Order_id
   
   join_one: inventory_items             full on order_items.Inventory_item_id   = inventory_items.Id
   join_one: products                    full on inventory_items.Product_id      = products.Id
   join_one: distribution_centers        full on products.Distribution_center_id = distribution_centers.Id


// common dimensions
dimension:
  #(doc) "The country where the customer resides."
  `User_Country`        is pick users.User_Country              when Stage = "users" 
                           pick order_items.User_Country        when Stage = "order_items"
                           pick events.User_Country             when Stage = "events"
                           else null

  #(doc) "The city where the customer is located."
  `User_City`           is pick users.User_City                 when Stage = "users" 
                           pick order_items.User_City           when Stage = "order_items"
                           pick events.User_City                when Stage = "events"
                           else null

  #(doc) "The state or province where the customer is located."
  `User_State`          is pick users.User_State                when Stage = "users" 
                           pick order_items.User_State          when Stage = "order_items"
                           pick events.User_State               when Stage = "events"
                           else null

  #(doc) "The age of the customer in years."
  `User_Age`            is pick users.User_Age                  when Stage = "users" 
                           pick order_items.User_Age            when Stage = "order_items"
                           pick events.User_Age                 when Stage = "events"
                           else null

  #(doc) "The gender of the customer."
  `User_Gender`         is pick users.User_Gender                    when Stage = "users" 
                           pick order_items.User_Gender         when Stage = "order_items"
                           pick events.User_Gender              when Stage = "events"
                           else null

  #(doc) "The given name of the customer."
  `User_First_Name`     is pick users.User_First_name           when Stage = "users" 
                           pick order_items.User_First_Name     when Stage = "order_items"
                           pick events.User_First_Name          when Stage = "events"
                           else null

  #(doc) "The family name of the customer."
  `User_Last_Name`      is pick users.User_Last_name            when Stage = "users" 
                           pick order_items.User_Last_Name      when Stage = "order_items"
                           pick events.User_Last_Name           when Stage = "events"
                           else null

  #(doc) "The primary email address of the customer."
  `User_Email`          is pick users.User_Email                when Stage = "users" 
                           pick order_items.User_Email          when Stage = "order_items"
                           pick events.User_Email               when Stage = "events"
                           else null

  #(doc) "The marketing channel or source that brought the user to the site."
  `User_Traffic_Source` is pick users.User_Traffic_source       when Stage = "users" 
                           pick order_items.User_Traffic_Source when Stage = "order_items"
                           pick events.User_Traffic_Source      when Stage = "events"
                           else null

  #(doc) "The residential postal or ZIP code."
  `User_Postal_Code`    is pick users.User_Postal_code          when Stage = "users" 
                           pick order_items.User_Postal_Code    when Stage = "order_items"
                           pick events.User_Postal_Code         when Stage = "events"
                           else null

  #(doc) "The full street address of the customer."
  `User_Street_Address` is pick users.User_Street_address       when Stage = "users" 
                           pick order_items.User_Street_Address when Stage = "order_items"
                           pick events.User_Street_Address      when Stage = "events"
                           else null

  #(doc) "The GPS latitude coordinate of the customer's location."
  `User_Latitude`       is pick users.User_Latitude             when Stage = "users" 
                           pick order_items.User_Latitude       when Stage = "order_items"
                           pick events.User_Latitude            when Stage = "events"
                           else null

  #(doc) "The GPS longitude coordinate of the customer's location."
  `User_Longitude`      is pick users.User_Longitude            when Stage = "users" 
                           pick order_items.User_Longitude      when Stage = "order_items"
                           pick events.User_Longitude           when Stage = "events"
                           else null

  #(doc) "The timestamp when the customer account was created."
  `User_Created_at`     is pick users.User_Created_at           when Stage = "users" 
                           pick order_items.User_Created_at     when Stage = "order_items"
                           pick events.User_Created_at          when Stage = "events"
                           else null

  #(doc) "Geospatial point representation of the customer's address."
  `User_geom`           is pick users.User_geom                 when Stage = "users" 
                           pick order_items.User_geom           when Stage = "order_items"
                           pick events.User_geom                when Stage = "events"
                           else null

  measure:
    #(doc) "The ratio of unique orders to total web events, representing the overall conversion efficiency."
    `Conversion`                   is pick order_items.Order_Count
                                           / events.`Count`  
                            
                                      when events.`Count` != 0
                                      else 0
    
    #(doc) "Cost of Goods Sold: Total cost of inventory items that have a matching order."
    `Total Cost`                   is inventory_items.`Total Items Cost` { 
                                   where: order_items.Id is not null 
                                   }

    #(doc) "The total profit remaining after subtracting the cost of goods sold (COGS) from total revenue."
    `Total_Gross_Margin`           is order_items.`Total_Revenue` - `Total Cost`

    
    #(doc) "The average profitability per order, calculated as the total gross margin divided by the number of orders."
    `Average_Gross_Margin`         is pick Total_Gross_Margin 
                                           / order_items.Order_Count 
                            
                                      when order_items.Order_Count != 0
                                      else 0

    #(doc) "Markup Percentage: The profit expressed as a percentage of the cost (ROI on inventory investment)."
    #(doc) percent
    `Gross_Markup_Percent`         is pick `Total_Gross_Margin` / `Total Cost`
                                      when `Total Cost` != 0
                                      else 0
    #(doc) "The average number of orders placed per user across their lifetime."
    `Lifetime_Orders_Avg`          is pick order_items.Order_Count / users.Total_Users
                                      when users.Total_Users != 0
                                      else 0


}

