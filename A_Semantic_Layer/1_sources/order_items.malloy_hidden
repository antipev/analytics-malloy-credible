
import '../0_data/config.malloy_hidden'
import "users.malloy_hidden"

#(doc) "Individual line items for customer orders, including pricing, fulfillment status, and key timestamps."
source: order_items_source is order_items_raw extend {

  primary_key: Id

  rename:
    #(doc) "Unique identifier for each individual item within an order."
    `Id`     is id
    
    #(doc) "The timestamp when the order item was first created."
    `Created_at`        is created_at
    
    #(doc) "The timestamp when the item was successfully delivered to the customer."
    `Delivered_at`      is delivered_at
    
    #(doc) "Foreign key referencing the specific item in the inventory."
    `Inventory_item_id` is inventory_item_id
    
    #(doc) "Foreign key referencing the parent order containing this item."
    `Order_id`          is order_id
    
    #(doc) "Foreign key referencing the product being sold."
    `Product_id`        is product_id
    
    #(doc) "The timestamp when the item was returned by the customer, if applicable."
    `Returned_at`       is returned_at
    
    #(doc) "The price at which the individual item was sold to the customer."
    `Sale_price`        is sale_price
    
    #(doc) "The timestamp when the item was shipped from the warehouse."
    `Shipped_at`        is shipped_at
    
    #(doc) "The current lifecycle stage of the order item (e.g., 'Complete', 'Shipped', 'Processing')."
    `Status`            is status
    
    #(doc) "Foreign key referencing the customer who placed the order."
    `User_id`           is user_id

  measure: 
    #(doc) "The total gross sales value generated from all order items."
    `Total_Revenue` is sum(Sale_price)
    
    #(doc) "Total revenue specifically from orders that have reached the 'Complete' status."
    `Total_Revenue_Completed_Orders` is `Total_Revenue` { where: Status = 'Complete' }
    
    #(doc) "The total number of unique orders placed by customers."
    `Order_Count` is count(Order_id) 
   
    #(doc) "The total count of individual line items across all orders."
    `Order_Item_Count` is count(Id) 
    
    #(doc) "The total number of unique customers who have placed at least one order."
    `Total_Users` is count(User_id)
    
    #(doc) "The average price at which individual items were sold."
    `Average_Sale_Price` is avg(Sale_price)
    
    #(doc) "The average amount of money spent by each unique customer (Total_Revenue / Total_Users)."
    `Average_Spend_per_User` is `Total_Revenue` / `Total_Users`
    
    #(doc) "The average monetary value of each order (Total Revenue / Order Count)."
    `Average_Order_Value` is `Total_Revenue` / `Order_Count`

    #(doc) "The percentage contribution of the current grouping to the overall total revenue across all categories or segments."
    `Percent_Of_Total_Revenue` is `Total_Revenue`/all(`Total_Revenue`)


// adding join from dim tables where is necessary
  join_one: users_source                            on User_id=users_source.Id 
  
    dimension: 
    
    #(doc) "The country where the customer resides."
    `User_Country`      is users_source.User_Country,

    #(doc) "The city where the customer is located."
    `User_City`         is users_source.User_City,

    #(doc) "The state or province where the customer is located."
    `User_State`        is users_source.User_State,

    #(doc) "The age of the customer in years."
    `User_Age`          is users_source.User_Age,

    #(doc) "The gender of the customer."
    `User_Gender`       is users_source.User_Gender,

    #(doc) "The given name of the customer."
    `User_First_Name`   is users_source.User_First_name,

    #(doc) "The family name of the customer."
    `User_Last_Name`    is users_source.User_Last_name,

    #(doc) "The primary email address of the customer."
    `User_Email`        is users_source.User_Email,

    #(doc) "The marketing channel or source that brought the user to the site."
    `User_Traffic_Source` is users_source.User_Traffic_source,

    #(doc) "The residential postal or ZIP code."
    `User_Postal_Code`  is users_source.User_Postal_code,

    #(doc) "The full street address of the customer."
    `User_Street_Address` is users_source.User_Street_address,

    #(doc) "The GPS latitude coordinate of the customer's location."
    `User_Latitude`     is users_source.User_Latitude,

    #(doc) "The GPS longitude coordinate of the customer's location."
    `User_Longitude`    is users_source.User_Longitude,

    #(doc) "The timestamp when the customer account was created."
    `User_Created_at`   is users_source.User_Created_at,

    #(doc) "Geospatial point representation of the customer's address."
    `User_geom`         is users_source.User_geom


}